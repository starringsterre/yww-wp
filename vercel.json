{
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm exec vite build && node scripts/generate-sitemap.mjs",
  "outputDirectory": "dist/spa",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/wp-json/:path*", "destination": "https://cms.youngwisewomen.nl/wp-json/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
